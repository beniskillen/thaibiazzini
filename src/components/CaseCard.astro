---
import { caseStudies } from '../data/cases';
import { withBase } from '../data/site';

interface Props {
  featured?: boolean;
}

const { featured = false } = Astro.props;
const studies = featured ? caseStudies.filter((item) => item.slug !== 'shiv-nair') : caseStudies;
---

<div class="card-grid">
  {studies.map((study) => (
    <a
      class="work-card"
      href={withBase(`/work/${study.slug}`)}
      data-track="case_study_open"
      data-track-meta={study.slug}
      data-cursor-label="Study"
    >
      <figure class="work-card-media">
        <img
          src={withBase(study.coverImage.src)}
          alt={study.coverImage.alt}
          width="960"
          height="720"
        />
      </figure>
      <span class="eyebrow">{study.eyebrow}</span>
      <h3>{study.cardTitle}</h3>
      <p>{study.cardSummary}</p>
      <p><strong>{study.proofLine}</strong></p>
      <span class="microcopy">Read the case study</span>
    </a>
  ))}
</div>
