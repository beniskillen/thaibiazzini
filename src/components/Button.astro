---
import { withBase } from '../data/site';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'on-dark' | 'ghost-dark';
  event?: string;
  meta?: string;
}

const { href, variant = 'primary', event, meta } = Astro.props;
const showSpark = variant === 'primary' || variant === 'on-dark';
---

<a
  class={`btn btn-${variant}`}
  href={withBase(href)}
  data-track={event}
  data-track-meta={meta}
  data-cursor-label="Open"
>
  {showSpark && <span class="dot" aria-hidden="true">.</span>}
  <span class="btn-label"><slot /></span>
  {showSpark && <span class="spark" aria-hidden="true"></span>}
</a>
